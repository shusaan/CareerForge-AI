# CareerForge AI Environment Variables

# All features work without any configuration.
# Set these only if you want optional features.

# Database (optional — enables cloud sync)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/careerforge

# Auth (optional — enables multi-device sync)
# BETTER_AUTH_SECRET=change-this-to-a-random-secret
# BETTER_AUTH_URL=http://localhost:3000

# AI (optional — uses local prompts as fallback)
# OPENAI_API_KEY=
